# Multilogin X + Selenium
# Coupons: SAAS50 (browser) / MIN50 (Cloud Phone) via Telegram bot
# https://antidetect-automation.github.io/guides/selenium-mlx/

# Mode A — after Launcher start with automation_type=selenium
SELENIUM_URL=http://127.0.0.1:XXXX

# Mode B
# MLX_EMAIL=
# MLX_PASSWORD=
# MLX_FOLDER_ID=
# MLX_PROFILE_ID=
# HEADLESS=false

TARGET_URL=https://example.com
