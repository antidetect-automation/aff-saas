# Multilogin X + Playwright
# https://antidetect-automation.github.io/guides/playwright-mlx/
# Official example: https://multilogin.com/help/en_US/api-multilogin/playwright-automation-example

# Mode A — profile already started
CDP_URL=http://127.0.0.1:9222

# Mode B — API start (Pro+; Multilogin app must be running)
# MLX_EMAIL=
# MLX_PASSWORD=
# MLX_TOKEN=
# MLX_FOLDER_ID=
# MLX_PROFILE_ID=
# MLX_LAUNCHER_BASE=https://launcher.mlx.yt:45001
# MLX_SIGNIN_URL=https://api.multilogin.com/user/signin
# HEADLESS=false

TARGET_URL=https://example.com
